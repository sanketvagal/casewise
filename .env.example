# Copy to .env (gitignored). Read by the casewise CLI from the working directory.
GROQ_API_KEY=
# The evaluation judge (casewise eval) and the data generator (casewise generate) run on
# Gemini: a key from Google AI Studio.
GEMINI_API_KEY=

